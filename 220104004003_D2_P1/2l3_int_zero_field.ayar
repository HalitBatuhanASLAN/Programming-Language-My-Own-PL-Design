// Integer literal 0 as a hyperparameter field value.
// Tests that INT_LITERAL is produced for "0" and that the parser
// accepts it as a valid field_value (int kind).
// Also exercises that 0 is not mistaken for a FLOAT_LITERAL.

dataset d = load("data/zeros.csv");

split d into train(0.80), validation(0.10), test(0.10);

model SVM svm_zero
{
    C = 0,
    kernel = "linear",
    probability = false
}

experiment e
{
    train svm_zero on d.train;
    evaluate svm_zero on d.validation;
    collect metrics [accuracy];
    compare by accuracy higher_is_better;
    select best;
}

evaluate e.best on d.test;

report r
{
    metrics = [accuracy],
    show = overfitting_analysis
}
